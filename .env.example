# Copy this file to .env for local development.
#
# Local database (Supabase — recommended):
#   1. Open the "schoolarship app" project in Supabase (org: Techma hosted db).
#   2. Project Settings → Database → copy the connection strings.
#   3. Use the "Transaction pooler" URI for DATABASE_URL (port 6543, ?pgbouncer=true).
#   4. Use the "Direct connection" URI for DIRECT_URL (port 5432).
#
# Optional fallback: Docker Postgres — see docker-compose.yml and README.

# Pooled connection (Prisma at runtime). Supabase local dev only.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-1-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (Prisma migrations). Required with Supabase.
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-1-us-west-2.pooler.supabase.com:5432/postgres"

# Auth.js v5 secret. Generate one with: openssl rand -base64 32
AUTH_SECRET="generate_a_strong_secret_here"

# Directory where uploaded files are stored (filesystem backend only).
UPLOAD_DIR="uploads"

# Upload storage backend: omit or any value other than "blobs" = local filesystem.
# Netlify production sets UPLOAD_BACKEND=blobs (see netlify.toml) for durable storage.
# UPLOAD_BACKEND="blobs"

# --- Netlify production (Site configuration → Environment variables) ---
# Copy the same Supabase Postgres URIs as above for DATABASE_URL and DIRECT_URL.
# The Netlify Supabase extension injects API keys only; Prisma needs the Postgres URLs.
# Also set AUTH_SECRET. UPLOAD_BACKEND=blobs is set in netlify.toml for production.
