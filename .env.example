# Copy this file to .env for local development.
#
# Local Postgres (Docker):
#   docker compose up -d
#   docker compose ps   # wait for the "healthy" status
#
# No Docker MCP required — everything runs through the terminal.

# Database connection. On Replit, set this in the project secrets.
DATABASE_URL="postgresql://scholarship:scholarship_dev@localhost:5432/scholarship"

# Auth.js v5 secret. Generate one with: openssl rand -base64 32
AUTH_SECRET="generate_a_strong_secret_here"

# Directory where uploaded files are stored (relative to project root).
UPLOAD_DIR="uploads"
